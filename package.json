{
  "name": "hono-react-router",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "db:generate": "dotenv -- drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply --local DB",
    "db:migrate-production": "dotenv -- drizzle-kit migrate",
    "dev": "react-router dev",
    "start": "wrangler dev",
    "typegen": "react-router typegen",
    "lint": "pnpm /^lint:.*/",
    "lint:fmt": "oxfmt --check .",
    "lint:tsc": "pnpm typegen && tsc --noEmit --project tsconfig.cloudflare.json",
    "lint:oxlint": "oxlint .",
    "fmt": "oxfmt .",
    "test": "vitest run -c vitest.config.ts",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@react-router/node": "^7.1.3",
    "@react-router/serve": "^7.1.3",
    "better-auth": "^1.6.9",
    "drizzle-orm": "~0.45.0",
    "drizzle-zod": "^0.8.0",
    "hono": "^4.7.4",
    "hono-react-router-adapter": "^0.6.2",
    "isbot": "^5.1.17",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.1.3",
    "ulidx": "^2.4.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.0.0",
    "@hono/vite-dev-server": "^0.26.0",
    "@react-router/dev": "^7.1.3",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "cloudflare": "^7.0.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "~0.31.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9"
  }
}
